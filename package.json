{
  "name": "bankcore",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "dev:gateway": "npx nx serve api-gateway",
    "dev:iam": "npx nx serve iam-service",
    "dev:accounts": "npx nx serve account-service",
    "dev:transactions": "npx nx serve transaction-service",
    "dev:notifications": "npx nx serve notification-service",
    "dev:all": "npx nx run-many -t serve -p api-gateway iam-service account-service transaction-service notification-service",
    "build:all": "npx nx run-many -t build",
    "lint:all": "npx nx run-many -t lint",
    "test:all": "npx nx run-many -t test",
    "prisma:generate": "npx prisma generate --schema=libs/prisma-client/prisma/schema.prisma",
    "prisma:migrate": "npx prisma migrate dev --schema=libs/prisma-client/prisma/schema.prisma",
    "prisma:studio": "npx prisma studio --schema=libs/prisma-client/prisma/schema.prisma",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:reset": "docker compose down -v && docker compose up -d"
  },
  "private": true,
  "devDependencies": {
    "@eslint/js": "^9.8.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@nx/eslint": "23.1.0",
    "@nx/eslint-plugin": "23.1.0",
    "@nx/jest": "23.1.0",
    "@nx/js": "23.1.0",
    "@nx/nest": "^23.1.0",
    "@swc-node/register": "1.11.1",
    "@swc/core": "1.15.8",
    "@swc/helpers": "0.5.18",
    "@swc/jest": "~0.2.38",
    "@types/jest": "~30.0.0",
    "@types/node": "^24.0.0",
    "eslint": "^9.8.0",
    "eslint-config-prettier": "^10.0.0",
    "jest": "~30.3.0",
    "jest-environment-node": "~30.3.0",
    "jest-util": "~30.3.0",
    "jsonc-eslint-parser": "^2.1.0",
    "nx": "23.1.0",
    "prettier": "^3.8.1",
    "prisma": "^6.9.0",
    "ts-jest": "^29.4.7",
    "ts-node": "10.9.1",
    "tslib": "^2.3.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.58.0",
    "verdaccio": "^6.3.2"
  },
  "workspaces": [
    "apps/*",
    "libs/*"
  ],
  "dependencies": {
    "@nestjs/common": "^11.1.28",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.1.28",
    "@nestjs/microservices": "^11.1.28",
    "@nestjs/passport": "^11.0.0",
    "@nestjs/platform-express": "^11.1.28",
    "@nestjs/swagger": "^11.2.0",
    "@nestjs/throttler": "^6.0.0",
    "@prisma/client": "^6.9.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "ioredis": "^5.6.0",
    "kafkajs": "^2.2.4",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "@types/passport-jwt": "^4.0.1",
    "amqplib": "^0.10.5",
    "@types/amqplib": "^0.10.5",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "uuid": "^11.1.0"
  },
  "nx": {
    "includedScripts": [],
    "targets": {
      "local-registry": {
        "executor": "@nx/js:verdaccio",
        "options": {
          "port": 4873,
          "config": ".verdaccio/config.yml",
          "storage": "tmp/local-registry/storage"
        }
      }
    }
  }
}
