{
  "name": "bankcore",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "dev": "npm-run-all --parallel dev:gateway dev:iam dev:accounts dev:transactions dev:loan dev:notifications dev:workflow dev:web",
    "dev:gateway": "nest start api-gateway --watch",
    "dev:iam": "nest start iam-service --watch",
    "dev:accounts": "nest start account-service --watch",
    "dev:transactions": "nest start transaction-service --watch",
    "dev:notifications": "nest start notification-service --watch",
    "dev:loan": "nest start loan-service --watch",
    "dev:workflow": "nest start workflow-service --watch",
    "dev:web": "npm run dev --prefix apps/web-portal",
    "build:all": "npm-run-all build:gateway build:iam build:accounts build:transactions build:notifications build:loan build:workflow build:web",
    "build:gateway": "nest build api-gateway",
    "build:iam": "nest build iam-service",
    "build:accounts": "nest build account-service",
    "build:transactions": "nest build transaction-service",
    "build:notifications": "nest build notification-service",
    "build:loan": "nest build loan-service",
    "build:workflow": "nest build workflow-service",
    "build:web": "npm run build --prefix apps/web-portal",
    "lint:all": "eslint \"{src,apps,libs,test}/**/*.ts\"",
    "test:all": "jest",
    "prisma:generate": "npx prisma generate --schema=libs/prisma-client/prisma/schema.prisma",
    "prisma:migrate": "npx prisma migrate dev --schema=libs/prisma-client/prisma/schema.prisma",
    "prisma:migrate:deploy": "npx prisma migrate deploy --schema=libs/prisma-client/prisma/schema.prisma",
    "prisma:migrate:reset": "npx prisma migrate reset --schema=libs/prisma-client/prisma/schema.prisma --force",
    "prisma:studio": "npx prisma studio --schema=libs/prisma-client/prisma/schema.prisma",
    "prisma:seed": "npx prisma db seed --schema=libs/prisma-client/prisma/schema.prisma"
  },
  "private": true,
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@nx/eslint-plugin": "^23.1.1",
    "@types/jest": "~30.0.0",
    "@types/node": "^24.13.3",
    "eslint": "^9.8.0",
    "eslint-config-prettier": "^10.0.0",
    "jest": "~30.3.0",
    "jest-environment-node": "~30.3.0",
    "jest-util": "~30.3.0",
    "jsonc-eslint-parser": "^2.1.0",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.8.1",
    "prisma": "^6.9.0",
    "ts-jest": "^29.4.7",
    "ts-loader": "^9.6.2",
    "ts-node": "10.9.1",
    "tslib": "^2.3.0",
    "typescript": "~5.6.3",
    "typescript-eslint": "^8.66.0",
    "webpack": "^5.101.3",
    "webpack-cli": "^7.0.0",
    "webpack-dev-server": "^5.2.1"
  },
  "workspaces": [
    "apps/web-portal"
  ],
  "dependencies": {
    "@nestjs/axios": "^4.0.1",
    "@nestjs/common": "^11.1.28",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.1.28",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/microservices": "^11.1.28",
    "@nestjs/passport": "^11.0.0",
    "@nestjs/platform-express": "^11.1.28",
    "@nestjs/platform-socket.io": "^11.1.29",
    "@nestjs/swagger": "^11.2.0",
    "@nestjs/throttler": "^6.0.0",
    "@nestjs/websockets": "^11.1.29",
    "@prisma/client": "^6.9.0",
    "@types/amqplib": "^0.10.5",
    "@types/passport-jwt": "^4.0.1",
    "amqplib": "^0.10.5",
    "axios": "^1.19.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "form-data": "^4.0.6",
    "http-proxy-middleware": "^4.2.0",
    "ioredis": "^5.6.0",
    "jwks-rsa": "^4.1.0",
    "kafkajs": "^2.2.4",
    "next": "^15.5.2",
    "next-auth": "^4.24.15",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "socket.io": "^4.8.3",
    "uuid": "^11.1.0"
  },
  "prisma": {
    "seed": "node libs/prisma-client/prisma/seed.mjs"
  }
}
