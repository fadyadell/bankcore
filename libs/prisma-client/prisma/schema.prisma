generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./bankcore.db"
}

// ─── IAM Domain ──────────────────────────────────────────

model User {
  id            String    @id @default(uuid()) 
  keycloakId    String    @unique @map("keycloak_id")
  email         String    @unique
  firstName     String    @map("first_name")
  lastName      String    @map("last_name")
  phone         String?
  dateOfBirth   DateTime? @map("date_of_birth")
  nationalId    String?   @unique @map("national_id")
  kycStatus String @default("PENDING") @map("kyc_status")
  status String @default("ACTIVE")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  accounts      Account[]
  auditLogs     AuditLog[]
  notifications Notification[]
  sagaInstances SagaInstance[]
  loans         Loan[]

  @@index([status, kycStatus])
  @@map("users")
}





// ─── Account Domain ──────────────────────────────────────

model Account {
  id            String        @id @default(uuid()) 
  accountNumber String        @unique @map("account_number")
  userId        String        @map("user_id") 
  type String
  currency      String        @default("USD") 
  balance       Decimal       @default(0) 
  availableBalance Decimal    @default(0) @map("available_balance") 
  status String @default("ACTIVE")
  interestRate  Decimal?      @map("interest_rate") 
  overdraftLimit Decimal?     @map("overdraft_limit") 
  openedAt      DateTime      @default(now()) @map("opened_at")
  closedAt      DateTime?     @map("closed_at")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  user          User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  debitTransactions  Transaction[] @relation("DebitAccount")
  creditTransactions Transaction[] @relation("CreditAccount")
  ledgerEntries LedgerEntry[]
  sagaSteps      SagaStep[]

  @@index([userId])
  @@index([status])
  @@index([type, status])
  @@index([currency])
  @@map("accounts")
}





// ─── Loan Domain ─────────────────────────────────────────

model Loan {
  id              String         @id @default(uuid()) 
  referenceNumber String         @unique @map("reference_number")
  userId          String         @map("user_id") 
  amount          Decimal        
  currency        String         @default("USD") 
  interestRate    Decimal        @map("interest_rate") 
  termMonths      Int            @map("term_months")
  purpose         String?
  status String @default("PENDING")
  riskScore       Int?           @map("risk_score")
  riskLevel       String?        @map("risk_level")
  appliedAt       DateTime       @default(now()) @map("applied_at")
  approvedAt      DateTime?      @map("approved_at")
  rejectedAt      DateTime?      @map("rejected_at")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  user            User           @relation(fields: [userId], references: [id], onDelete: Restrict)
  approvals       Approval[]

  @@index([userId])
  @@index([status])
  @@index([appliedAt])
  @@map("loans")
}



// ─── Approval Domain ─────────────────────────────────────

model Approval {
  id              String         @id @default(uuid()) 
  entityType      String         @map("entity_type")
  entityId        String         @map("entity_id") 
  reviewerId      String         @map("reviewer_id") 
  role            String
  status String @default("PENDING")
  comments        String?
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  loan            Loan?          @relation(fields: [entityId], references: [id])

  @@index([entityType, entityId])
  @@index([reviewerId])
  @@index([status])
  @@map("approvals")
}



// ─── Transaction Domain ──────────────────────────────────

model Transaction {
  id              String            @id @default(uuid()) 
  referenceNumber String            @unique @map("reference_number")
  idempotencyKey  String?           @unique @map("idempotency_key")
  type String
  status String @default("PENDING")
  amount          Decimal           
  currency        String            @default("USD") 
  description     String?
  debitAccountId  String?           @map("debit_account_id") 
  creditAccountId String?           @map("credit_account_id") 
  metadata        Json?
  failureReason   String?           @map("failure_reason")
  processedAt     DateTime?         @map("processed_at")
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  debitAccount    Account?          @relation("DebitAccount", fields: [debitAccountId], references: [id])
  creditAccount   Account?          @relation("CreditAccount", fields: [creditAccountId], references: [id])
  ledgerEntries   LedgerEntry[]
  outboxEvents    OutboxEvent[]
  sagaSteps       SagaStep[]

  @@index([debitAccountId])
  @@index([creditAccountId])
  @@index([status])
  @@index([createdAt])
  @@index([type, status, createdAt])
  @@index([referenceNumber, createdAt])
  @@map("transactions")
}





// ─── Double-Entry Ledger ─────────────────────────────────

model LedgerEntry {
  id            String      @id @default(uuid()) 
  transactionId String      @map("transaction_id") 
  accountId     String      @map("account_id") 
  entryType String   @map("entry_type")
  amount        Decimal     
  balanceAfter  Decimal     @map("balance_after") 
  createdAt     DateTime    @default(now()) @map("created_at")

  transaction   Transaction @relation(fields: [transactionId], references: [id])
  account       Account     @relation(fields: [accountId], references: [id])

  @@index([transactionId])
  @@index([accountId])
  @@index([createdAt])
  @@unique([transactionId, accountId, entryType])
  @@map("ledger_entries")
}



// ─── Audit Log ───────────────────────────────────────────

model AuditLog {
  id          String   @id @default(uuid()) 
  userId      String?  @map("user_id") 
  action      String
  resource    String
  resourceId  String?  @map("resource_id")
  oldValue    Json?    @map("old_value")
  newValue    Json?    @map("new_value")
  ipAddress   String?  @map("ip_address")
  userAgent   String?  @map("user_agent")
  createdAt   DateTime @default(now()) @map("created_at")

  user        User?    @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([resource, resourceId])
  @@index([createdAt])
  @@index([action, createdAt])
  @@map("audit_logs")
}

// ─── Notification Domain ─────────────────────────────────

model Notification {
  id          String             @id @default(uuid()) 
  userId      String             @map("user_id") 
  channel String
  type        String
  subject     String?
  body        String
  status String @default("PENDING")
  metadata    Json?
  sentAt      DateTime?          @map("sent_at")
  failedAt    DateTime?          @map("failed_at")
  failureReason String?          @map("failure_reason")
  createdAt   DateTime           @default(now()) @map("created_at")

  user        User               @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@index([channel, status, createdAt])
  @@map("notifications")
}

// ─── Integration Patterns ───────────────────────────────

model OutboxEvent {
  id               String       @id @default(uuid()) 
  eventId          String       @unique @map("event_id") 
  aggregateType    String       @map("aggregate_type")
  aggregateId      String       @map("aggregate_id") 
  eventType        String       @map("event_type")
  payload          Json
  headers          Json?
  status String @default("PENDING")
  transactionId    String?      @map("transaction_id") 
  occurredAt       DateTime     @default(now()) @map("occurred_at")
  availableAt      DateTime     @default(now()) @map("available_at")
  processedAt      DateTime?    @map("processed_at")
  retryCount       Int          @default(0) @map("retry_count")
  lastError        String?      @map("last_error")
  correlationId    String?      @map("correlation_id")
  causationId      String?      @map("causation_id")
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")

  transaction      Transaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)

  @@index([status, availableAt])
  @@index([aggregateType, aggregateId])
  @@index([occurredAt])
  @@index([correlationId])
  @@map("outbox_events")
}



model InboxMessage {
  id              String   @id @default(uuid()) 
  messageId       String   @unique @map("message_id")
  source          String
  topic           String
  partition       Int?
  offset          String?
  key             String?
  payload         Json
  headers         Json?
  receivedAt      DateTime @default(now()) @map("received_at")
  processedAt     DateTime? @map("processed_at")
  processingError String?  @map("processing_error")

  @@index([source, topic])
  @@index([receivedAt])
  @@map("inbox_messages")
}

model SagaInstance {
  id              String      @id @default(uuid()) 
  sagaType        String      @map("saga_type")
  correlationId   String      @unique @map("correlation_id")
  initiatorUserId String?     @map("initiator_user_id") 
  status String @default("STARTED")
  context         Json?
  startedAt       DateTime    @default(now()) @map("started_at")
  completedAt     DateTime?   @map("completed_at")
  failedAt        DateTime?   @map("failed_at")
  failureReason   String?     @map("failure_reason")
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  initiatorUser   User?       @relation(fields: [initiatorUserId], references: [id], onDelete: SetNull)
  steps           SagaStep[]

  @@index([status, startedAt])
  @@index([sagaType, status])
  @@map("saga_instances")
}



model SagaStep {
  id                String         @id @default(uuid()) 
  sagaInstanceId    String         @map("saga_instance_id") 
  stepName          String         @map("step_name")
  stepOrder         Int            @map("step_order")
  status String @default("PENDING")
  transactionId     String?        @map("transaction_id") 
  accountId         String?        @map("account_id") 
  requestPayload    Json?          @map("request_payload")
  responsePayload   Json?          @map("response_payload")
  compensationPayload Json?        @map("compensation_payload")
  startedAt         DateTime?      @map("started_at")
  completedAt       DateTime?      @map("completed_at")
  failedAt          DateTime?      @map("failed_at")
  failureReason     String?        @map("failure_reason")
  createdAt         DateTime       @default(now()) @map("created_at")
  updatedAt         DateTime       @updatedAt @map("updated_at")

  sagaInstance      SagaInstance   @relation(fields: [sagaInstanceId], references: [id], onDelete: Cascade)
  transaction       Transaction?   @relation(fields: [transactionId], references: [id], onDelete: SetNull)
  account           Account?       @relation(fields: [accountId], references: [id], onDelete: SetNull)

  @@index([sagaInstanceId, stepOrder])
  @@index([status])
  @@index([transactionId])
  @@index([accountId])
  @@unique([sagaInstanceId, stepOrder])
  @@map("saga_steps")
}






