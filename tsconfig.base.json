{
  "compilerOptions": {
    "composite": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "importHelpers": true,
    "isolatedModules": true,
    "lib": [
      "es2022"
    ],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "noEmitOnError": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "es2022",
    "customConditions": [
      "bankcore"
    ],
    "noUncheckedSideEffectImports": false,
    "types": [
      "*"
    ],
    "paths": {
      "@bankcore/common": ["./libs/common/src/index.ts"],
      "@bankcore/prisma-client": ["./libs/prisma-client/src/index.ts"],
      "@bankcore/auth": ["./libs/auth/src/index.ts"],
      "@bankcore/messaging": ["./libs/messaging/src/index.ts"],
      "@bankcore/cache": ["./libs/cache/src/index.ts"]
    }
  }
}