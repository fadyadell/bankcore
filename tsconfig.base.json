{
  "compilerOptions": {
    "composite": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "importHelpers": true,
    "isolatedModules": true,
    "lib": [
      "es2022",
      "dom",
      "dom.iterable"
    ],
    "module": "esnext",
    "moduleResolution": "bundler",
    "noEmitOnError": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "skipLibCheck": true,
    "strict": true,
    "rootDir": ".",
    "target": "es2022",
    "customConditions": [
      "bankcore"
    ],
    "noUncheckedSideEffectImports": false,
    "ignoreDeprecations": "5.0",
    "baseUrl": ".",
    "paths": {
      "@bankcore/common": [
        "./libs/common/src/index.ts"
      ],
      "@bankcore/database": [
        "./libs/database/src/index.ts"
      ],
      "@bankcore/contracts": [
        "./libs/contracts/src/index.ts"
      ],
      "@bankcore/auth": [
        "./libs/auth/src/index.ts"
      ],
      "@bankcore/cache": [
        "./libs/cache/src/index.ts"
      ],
      "@bankcore/kafka": [
        "./libs/kafka/src/index.ts"
      ],
      "@bankcore/rabbitmq": [
        "./libs/rabbitmq/src/index.ts"
      ],
      "@bankcore/rules": [
        "./libs/rules/src/index.ts"
      ]
    }
  }
}