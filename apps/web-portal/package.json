{
  "name": "@bankcore/web-portal",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "next dev -p 4200",
    "build": "next build",
    "start": "next start",
    "lint": "next lint"
  },
  "nx": {
    "name": "web-portal",
    "targets": {
      "build": {
        "executor": "nx:run-commands",
        "options": {
          "command": "next build",
          "cwd": "apps/web-portal"
        }
      },
      "serve": {
        "executor": "nx:run-commands",
        "options": {
          "command": "next dev -p 4200",
          "cwd": "apps/web-portal"
        }
      },
      "start": {
        "executor": "nx:run-commands",
        "options": {
          "command": "next start -p 4200",
          "cwd": "apps/web-portal"
        }
      }
    }
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.3.3",
    "axios": "^1.19.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "jwt-decode": "^4.0.0",
    "lucide-react": "^1.31.0",
    "next": "^15.5.2",
    "next-auth": "^4.24.15",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "recharts": "^3.10.1",
    "socket.io-client": "^4.8.3",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/react": "19.2.18",
    "autoprefixer": "^10.5.4",
    "postcss": "^8.5.26",
    "tailwindcss": "^4.3.3"
  }
}
