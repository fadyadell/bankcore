{
  "name": "@bankcore/web-portal",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint"
  },
  "nx": {
    "name": "web-portal",
    "targets": {
      "build": {
        "executor": "nx:run-commands",
        "options": {
          "command": "next build",
          "cwd": "apps/web-portal"
        }
      },
      "serve": {
        "executor": "nx:run-commands",
        "options": {
          "command": "next dev -p 4200",
          "cwd": "apps/web-portal"
        }
      },
      "start": {
        "executor": "nx:run-commands",
        "options": {
          "command": "next start -p 4200",
          "cwd": "apps/web-portal"
        }
      }
    }
  },
  "dependencies": {
    "next": "^15.5.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  }
}
