{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "../../dist/apps/account-service",
    "tsBuildInfoFile": "./dist/tsconfig.app.tsbuildinfo",
    "emitDeclarationOnly": false,
    "forceConsistentCasingInFileNames": true,
    "types": [
      "node"
    ],
    "target": "es2021",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "strictNullChecks": true,
    "noImplicitAny": true,
    "strictBindCallApply": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": [
    "./src/**/*.ts"
  ],
  "references": [
    {
      "path": "../../libs/cache/tsconfig.lib.json"
    },
    {
      "path": "../../libs/database/tsconfig.lib.json"
    },
    {
      "path": "../../libs/auth/tsconfig.lib.json"
    },
    {
      "path": "../../libs/common/tsconfig.lib.json"
    },
    {
      "path": "../../libs/kafka/tsconfig.lib.json"
    },
    {
      "path": "../../libs/rabbitmq/tsconfig.lib.json"
    },
    {
      "path": "../../libs/rules/tsconfig.lib.json"
    }
  ],
  "exclude": [
    "./src/**/*.spec.ts",
    "./src/**/*.test.ts"
  ]
}