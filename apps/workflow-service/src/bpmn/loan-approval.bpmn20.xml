<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:flowable="http://flowable.org/bpmn"
  typeLanguage="http://www.w3.org/2001/XMLSchema"
  expressionLanguage="http://www.w3.org/1999/XPath"
  targetNamespace="http://www.flowable.org/processdef">

  <process id="loanApproval" name="Loan Approval Process" isExecutable="true">
    
    <startEvent id="start" />
    <sequenceFlow id="flow1" sourceRef="start" targetRef="parallelVerifications" />

    <!-- PARALLEL VERIFICATIONS -->
    <parallelGateway id="parallelVerifications" />
    <sequenceFlow id="toNationalId" sourceRef="parallelVerifications" targetRef="verifyNationalId" />
    <sequenceFlow id="toTaxCheck" sourceRef="parallelVerifications" targetRef="verifyTax" />

    <!-- NATIONAL ID VERIFICATION -->
    <serviceTask id="verifyNationalId" name="Verify National ID" flowable:type="http">
      <extensionElements>
        <flowable:field name="requestMethod"><flowable:string>POST</flowable:string></flowable:field>
        <flowable:field name="requestUrl"><flowable:string>http://localhost:3007/delegates/verify-national-id</flowable:string></flowable:field>
        <flowable:field name="requestHeaders"><flowable:string>Content-Type: application/json</flowable:string></flowable:field>
        <flowable:field name="requestBody"><flowable:expression>{"loanId":"${loanId}"}</flowable:expression></flowable:field>
      </extensionElements>
    </serviceTask>

    <boundaryEvent id="nationalIdError" attachedToRef="verifyNationalId">
      <errorEventDefinition errorRef="VERIFICATION_FAILED" />
    </boundaryEvent>
    <sequenceFlow id="toMissingData1" sourceRef="nationalIdError" targetRef="missingDataTask1" />
    <userTask id="missingDataTask1" name="Provide Missing ID Data" flowable:candidateGroups="ADMIN" />
    <sequenceFlow id="resume1" sourceRef="missingDataTask1" targetRef="verifyNationalId" />

    <sequenceFlow id="fromNationalId" sourceRef="verifyNationalId" targetRef="joinVerifications" />

    <!-- TAX CHECK VERIFICATION -->
    <serviceTask id="verifyTax" name="Verify Tax Clearance" flowable:type="http">
      <extensionElements>
        <flowable:field name="requestMethod"><flowable:string>POST</flowable:string></flowable:field>
        <flowable:field name="requestUrl"><flowable:string>http://localhost:3007/delegates/verify-tax</flowable:string></flowable:field>
        <flowable:field name="requestHeaders"><flowable:string>Content-Type: application/json</flowable:string></flowable:field>
        <flowable:field name="requestBody"><flowable:expression>{"loanId":"${loanId}"}</flowable:expression></flowable:field>
      </extensionElements>
    </serviceTask>

    <boundaryEvent id="taxError" attachedToRef="verifyTax">
      <errorEventDefinition errorRef="VERIFICATION_FAILED" />
    </boundaryEvent>
    <sequenceFlow id="toMissingData2" sourceRef="taxError" targetRef="missingDataTask2" />
    <userTask id="missingDataTask2" name="Provide Missing Tax Data" flowable:candidateGroups="ADMIN" />
    <sequenceFlow id="resume2" sourceRef="missingDataTask2" targetRef="verifyTax" />

    <sequenceFlow id="fromTaxCheck" sourceRef="verifyTax" targetRef="joinVerifications" />

    <!-- JOIN VERIFICATIONS -->
    <parallelGateway id="joinVerifications" />
    <sequenceFlow id="toRiskEval" sourceRef="joinVerifications" targetRef="evaluateRisk" />

    <!-- RISK EVALUATION -->
    <serviceTask id="evaluateRisk" name="Evaluate Loan Risk" flowable:type="http">
      <extensionElements>
        <flowable:field name="requestMethod"><flowable:string>POST</flowable:string></flowable:field>
        <flowable:field name="requestUrl"><flowable:string>http://localhost:3007/delegates/evaluate-loan-risk</flowable:string></flowable:field>
        <flowable:field name="requestHeaders"><flowable:string>Content-Type: application/json</flowable:string></flowable:field>
        <flowable:field name="requestBody"><flowable:expression>{"loanId":"${loanId}"}</flowable:expression></flowable:field>
        <flowable:field name="saveResponseParameters"><flowable:string>true</flowable:string></flowable:field>
        <flowable:field name="saveResponseVariableAsJson"><flowable:string>true</flowable:string></flowable:field>
        <flowable:field name="responseVariableName"><flowable:string>riskResponse</flowable:string></flowable:field>
      </extensionElements>
    </serviceTask>

    <sequenceFlow id="toRiskGateway" sourceRef="evaluateRisk" targetRef="riskGateway" />
    <exclusiveGateway id="riskGateway" />

    <!-- HIGH RISK (48h SLA) -->
    <sequenceFlow id="flowHigh" sourceRef="riskGateway" targetRef="highRiskReview">
      <conditionExpression xsi:type="tFormalExpression"><![CDATA[${riskResponse.get('riskTier').asText() == 'HIGH'}]]></conditionExpression>
    </sequenceFlow>
    <userTask id="highRiskReview" name="High Risk Admin Approval (3 of 5)" flowable:candidateGroups="ADMIN">
      <multiInstanceLoopCharacteristics isSequential="false">
        <loopCardinality>5</loopCardinality>
        <completionCondition>${nrOfCompletedInstances == 3}</completionCondition>
      </multiInstanceLoopCharacteristics>
    </userTask>
    <boundaryEvent id="timerHigh" attachedToRef="highRiskReview" cancelActivity="true">
      <timerEventDefinition><timeDuration>PT48H</timeDuration></timerEventDefinition>
    </boundaryEvent>
    <sequenceFlow id="flowEscalateHigh" sourceRef="timerHigh" targetRef="escalationTask" />
    <sequenceFlow id="flowHighMerge" sourceRef="highRiskReview" targetRef="mergeGateway" />

    <!-- MEDIUM RISK (24h SLA) -->
    <sequenceFlow id="flowMed" sourceRef="riskGateway" targetRef="standardReview">
      <conditionExpression xsi:type="tFormalExpression"><![CDATA[${riskResponse.get('riskTier').asText() == 'MEDIUM'}]]></conditionExpression>
    </sequenceFlow>
    <userTask id="standardReview" name="Medium Risk Admin Approval (3 of 5)" flowable:candidateGroups="ADMIN">
      <multiInstanceLoopCharacteristics isSequential="false">
        <loopCardinality>5</loopCardinality>
        <completionCondition>${nrOfCompletedInstances == 3}</completionCondition>
      </multiInstanceLoopCharacteristics>
    </userTask>
    <boundaryEvent id="timerMed" attachedToRef="standardReview" cancelActivity="true">
      <timerEventDefinition><timeDuration>PT24H</timeDuration></timerEventDefinition>
    </boundaryEvent>
    <sequenceFlow id="flowEscalateMed" sourceRef="timerMed" targetRef="escalationTask" />
    <sequenceFlow id="flowMedMerge" sourceRef="standardReview" targetRef="mergeGateway" />

    <!-- LOW RISK (AUTO) -->
    <sequenceFlow id="flowLow" sourceRef="riskGateway" targetRef="fastTrackReview">
      <conditionExpression xsi:type="tFormalExpression"><![CDATA[${riskResponse.get('riskTier').asText() == 'LOW'}]]></conditionExpression>
    </sequenceFlow>
    <userTask id="fastTrackReview" name="Low Risk Fast Track" flowable:candidateGroups="ADMIN" />
    <sequenceFlow id="flowLowMerge" sourceRef="fastTrackReview" targetRef="mergeGateway" />

    <!-- ESCALATION TASK -->
    <userTask id="escalationTask" name="SLA Escalation Review" flowable:candidateGroups="ADMIN" />
    <sequenceFlow id="flowEscalateMerge" sourceRef="escalationTask" targetRef="mergeGateway" />

    <exclusiveGateway id="mergeGateway" />
    <sequenceFlow id="flow3" sourceRef="mergeGateway" targetRef="finalDecisionGateway" />

    <exclusiveGateway id="finalDecisionGateway" />
    <sequenceFlow id="flowApprove" sourceRef="finalDecisionGateway" targetRef="approveLoanTask">
      <conditionExpression xsi:type="tFormalExpression"><![CDATA[${decision == 'APPROVED'}]]></conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="flowReject" sourceRef="finalDecisionGateway" targetRef="rejectLoanTask">
      <conditionExpression xsi:type="tFormalExpression"><![CDATA[${decision == 'REJECTED'}]]></conditionExpression>
    </sequenceFlow>

    <!-- APPROVE END -->
    <serviceTask id="approveLoanTask" name="Approve Loan" flowable:type="http">
      <extensionElements>
        <flowable:field name="requestMethod"><flowable:string>POST</flowable:string></flowable:field>
        <flowable:field name="requestUrl"><flowable:string>http://localhost:3007/delegates/approve-loan</flowable:string></flowable:field>
        <flowable:field name="requestHeaders"><flowable:string>Content-Type: application/json</flowable:string></flowable:field>
        <flowable:field name="requestBody"><flowable:expression>{"loanId":"${loanId}"}</flowable:expression></flowable:field>
      </extensionElements>
    </serviceTask>
    <sequenceFlow id="flowApproveEnd" sourceRef="approveLoanTask" targetRef="end1" />
    <endEvent id="end1" />

    <!-- REJECT END -->
    <serviceTask id="rejectLoanTask" name="Reject Loan" flowable:type="http">
      <extensionElements>
        <flowable:field name="requestMethod"><flowable:string>POST</flowable:string></flowable:field>
        <flowable:field name="requestUrl"><flowable:string>http://localhost:3007/delegates/reject-loan</flowable:string></flowable:field>
        <flowable:field name="requestHeaders"><flowable:string>Content-Type: application/json</flowable:string></flowable:field>
        <flowable:field name="requestBody"><flowable:expression>{"loanId":"${loanId}"}</flowable:expression></flowable:field>
      </extensionElements>
    </serviceTask>
    <sequenceFlow id="flowRejectEnd" sourceRef="rejectLoanTask" targetRef="end2" />
    <endEvent id="end2" />

  </process>
</definitions>
