version: '3.8'

services:
  postgres:
    image: postgres:15-alpine
    container_name: bankcore-postgres
    environment:
      POSTGRES_USER: bankcore
      POSTGRES_PASSWORD: bankcore_password
      POSTGRES_DB: bankcore_db
    ports:
      - '5432:5432'
    volumes:
      - postgres-data:/var/lib/postgresql/data
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U bankcore -d bankcore_db"]
      interval: 5s
      timeout: 5s
      retries: 5

volumes:
  postgres-data:

  gorules:
    image: gorules/brms
    container_name: bankcore-gorules
    ports:
      - '4000:4000'
    environment:
      - PORT=4000

  flowable:
    image: flowable/flowable-rest:6.8.0
    container_name: bankcore-flowable
    ports:
      - '8080:8080'
          - SERVER_PORT=8080
xq


